// full_load.cpp - 전체 로드 + 버킷 인덱스 방식
//
// [아이디어]
//   키(32비트)를 (키 - 최소키)로 바꾼 뒤 상위 비트 / 하위 shift 비트로 나눈다.
//     - start[b] : 상위 비트가 b인 첫 키의 위치  (uint32 배열, "버킷 시작 위치표")
//     - low[i]   : i번째 키의 하위 shift 비트     (uint8 배열, 키당 1바이트)
//   상위 비트는 버킷 번호로 이미 알 수 있으므로 저장하지 않는다 → 원본 800MB가 약 330MB로 줄어듦.
//
// [빌드]  파일을 처음부터 끝까지 한 번만 읽으며 start/low를 채움. O(n), 정렬 불필요.
// [탐색]  버킷 번호 계산 → start[b], start[b+1] 두 칸 읽기 → 버킷 안 몇 개(평균 6~8개) 확인. O(1)
//
// 사용법: full_load.exe <dataset 파일> [-q] [--limit512]
//   -q          : 결과 줄 출력 생략, 요약만 출력 (배치 모드)
//   --limit512  : Job Object로 이 프로세스 메모리를 512MB로 제한
#include "common.h"
#include <algorithm>
#include <memory>

class FullLoadIndex {
public:
    bool build(const char* path) {
        BinFile f;
        if (!f.open(path, BinFile::Sequential)) { fprintf(stderr, "cannot open %s\n", path); return false; }

        if (f.pread(&n_, 8, 0) != 8) { fprintf(stderr, "bad header\n"); return false; }
        if (f.size() < 8 + 4 * n_) { fprintf(stderr, "file too small for %llu keys\n", (unsigned long long)n_); return false; }
        if (n_ == 0) return true;
        f.pread(&minKey_, 4, 8);
        f.pread(&maxKey_, 4, 8 + 4 * (n_ - 1));

        // ---- shift 결정: 버킷 시작 위치표가 START_BUDGET 이하가 되는 가장 작은 shift ----
        //   sparse(범위 약 43억) → shift 7, 버킷 3,355만 개(128MB), 버킷당 평균 약 6개
        //   dense (범위 약 2억)  → shift 3, 버킷 약 2,500만 개(100MB), 버킷당 평균 약 8개
        const uint64_t START_BUDGET = 160ull << 20;   // 160MB
        uint64_t range = static_cast<uint64_t>(maxKey_ - minKey_);
        shift_ = 0;
        while (shift_ < 8 && ((range >> shift_) + 2) * 4 > START_BUDGET) ++shift_;
        mask_ = (1u << shift_) - 1;
        numBuckets_ = (range >> shift_) + 1;

        // calloc: OS가 0으로 채워진 페이지를 필요할 때 주므로 memset 비용이 거의 없음
        start_.reset(static_cast<uint32_t*>(calloc(numBuckets_ + 1, sizeof(uint32_t))));
        if (!start_) { fprintf(stderr, "out of memory\n"); return false; }
        if (shift_ > 0) low_.reset(new uint8_t[n_]);

        // ---- 파일을 큰 덩어리로 순차 읽기 ----
        const size_t CHUNK_KEYS = 4u << 20;                 // 4M개 = 16MB 버퍼
        std::unique_ptr<uint32_t[]> buf(new uint32_t[CHUNK_KEYS]);

        uint32_t* start = start_.get();
        uint8_t*  low   = low_.get();
        const uint32_t minKey = minKey_, mask = mask_;
        const int shift = shift_;
        uint64_t idx = 0;

        // 1단계: 각 키마다 start[버킷+1] = (자기 위치 + 1) 을 무조건 기록 (분기 없음)
        //        → 같은 버킷의 마지막 키가 마지막에 쓰므로 start[b+1] = 버킷 b의 끝 위치가 됨
        while (idx < n_) {
            size_t cnt = static_cast<size_t>(std::min<uint64_t>(CHUNK_KEYS, n_ - idx));
            if (f.pread(buf.get(), cnt * 4, 8 + 4 * idx) != static_cast<int64_t>(cnt * 4)) {
                fprintf(stderr, "read error\n"); return false;
            }
            const uint32_t* kb = buf.get();
            uint32_t pos = static_cast<uint32_t>(idx);
            if (low) {
                uint8_t* lp = low + idx;
                for (size_t j = 0; j < cnt; ++j) {
                    uint32_t k = kb[j] - minKey;
                    start[(k >> shift) + 1] = pos + static_cast<uint32_t>(j) + 1;
                    lp[j] = static_cast<uint8_t>(k & mask);
                }
            } else {
                for (size_t j = 0; j < cnt; ++j)
                    start[(kb[j] - minKey) + 1] = pos + static_cast<uint32_t>(j) + 1;
            }
            idx += cnt;
        }
        // 2단계: 빈 버킷(0으로 남은 칸)은 앞 칸 값을 이어받게 함 (누적 최대값, 분기 없음)
        uint32_t run = 0;
        for (uint64_t b = 1; b <= numBuckets_; ++b) {
            uint32_t v = start[b];
            run = v > run ? v : run;
            start[b] = run;
        }
        return true;
    }

    // key의 위치(처음 등장하는 위치) 반환, 없으면 -1
    inline int64_t find(uint32_t key) const {
        if (n_ == 0 || key < minKey_ || key > maxKey_) return -1;
        uint32_t k = key - minKey_;
        uint64_t b = k >> shift_;
        uint32_t s = start_[b], e = start_[b + 1];
        if (shift_ == 0) return s < e ? static_cast<int64_t>(s) : -1;   // 버킷 = 키 그 자체

        uint8_t t = static_cast<uint8_t>(k & mask_);
        const uint8_t* low = low_.get();
        if (e - s <= 32) {                                 // 보통 여기 (평균 6~8개)
            for (uint32_t i = s; i < e; ++i)
                if (low[i] >= t) return low[i] == t ? static_cast<int64_t>(i) : -1;
            return -1;
        }
        const uint8_t* p = std::lower_bound(low + s, low + e, t);  // 중복이 많은 버킷 대비
        return (p != low + e && *p == t) ? static_cast<int64_t>(p - low) : -1;
    }

    void printInfo() const {
        double mb = ((numBuckets_ + 1) * 4.0 + (shift_ > 0 ? n_ : 0)) / 1048576.0;
        printf("Keys            : %llu  (min %u, max %u)\n", (unsigned long long)n_, minKey_, maxKey_);
        printf("Bucket shift    : %d bits  (%llu buckets, avg %.2f keys/bucket)\n",
               shift_, (unsigned long long)numBuckets_, numBuckets_ ? (double)n_ / numBuckets_ : 0.0);
        printf("Index size      : %.1f MB\n", mb);
    }

private:
    uint64_t n_ = 0;
    uint32_t minKey_ = 0, maxKey_ = 0;
    int shift_ = 0;
    uint32_t mask_ = 0;
    uint64_t numBuckets_ = 0;
    struct FreeDeleter { void operator()(void* p) const { free(p); } };
    std::unique_ptr<uint32_t[], FreeDeleter> start_;
    std::unique_ptr<uint8_t[]>  low_;
};

int main(int argc, char** argv) {
    if (argc < 2) {
        fprintf(stderr, "usage: %s <dataset> [-q] [--limit512]\n", argv[0]);
        return 1;
    }
    if (hasFlag(argc, argv, "--limit512") && !applyMemoryLimit(512ull << 20))
        fprintf(stderr, "warning: failed to apply memory limit\n");

    FullLoadIndex index;
    Stopwatch sw;
    if (!index.build(argv[1])) return 1;
    double buildSec = sw.sec();

    printf("[Full load + bucket index]\n");
    index.printInfo();
    runQueries(index, buildSec, hasFlag(argc, argv, "-q"));
    printPeakMemory();
    return 0;
}
