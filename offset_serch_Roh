// offset_search.cpp - 파일 오프셋 직접 접근 + 희소 인덱스 + 보간 탐색 방식
//
// [아이디어]
//   파일은 [개수 8B][키0][키1]... 형태의 "디스크 위 정렬 배열"이다.
//   i번째 키의 오프셋 = 8 + 4*i 이므로 전체를 읽지 않고도 원하는 위치만 읽을 수 있다.
//
// [빌드]  헤더 + 일정 간격 샘플 키 SAMPLE_COUNT개만 읽어 "희소 인덱스"(작은 정렬 배열)를 만든다.
//         → 읽는 양은 수 KB, 빌드 시간은 수 ms.
// [탐색]  1) 희소 인덱스(메모리)에서 키가 속한 구간을 찾는다.
//         2) 구간 안에서 보간으로 위치를 추정한다 (uniform 데이터라 추정이 정확함).
//         3) 그 위치의 4KB 블록(키 1,024개)을 가져와 메모리에서 이진 탐색.
//         4) 블록 밖이면 범위를 좁혀 다시 보간 (보통 1~2번이면 끝).
//
// [파일 접근 방식 두 가지]
//   기본     : ReadFile(오프셋 지정)로 4KB 블록을 읽고, 최근 블록은 블록 캐시에 보관
//   --mmap   : 메모리 맵 파일. 블록을 복사하지 않고 주소로 바로 접근 (OS 캐시에 있을 때 더 빠름)
//
// 사용법: offset_search.exe <dataset 파일> [-q] [--mmap] [--limit512]
#include "common.h"
#include <algorithm>
#include <memory>

class OffsetIndex {
public:
    static constexpr uint32_t SAMPLE_COUNT   = 256;    // 희소 인덱스 크기 (빌드 시 랜덤 읽기 횟수)
    static constexpr uint32_t BLOCK_BYTES    = 4096;   // 디스크 페이지 크기
    static constexpr uint32_t KEYS_PER_BLOCK = BLOCK_BYTES / 4;
    static constexpr uint32_t CACHE_SLOTS    = 1024;   // 블록 캐시 (1024 x 4KB = 4MB), ReadFile 방식에서만 사용

    bool build(const char* path, bool useMmap) {
        useMmap_ = useMmap;
        if (useMmap_) {
            if (!map_.open(path) || map_.size() < 8) { fprintf(stderr, "cannot map %s\n", path); return false; }
            memcpy(&n_, map_.data(), 8);
            if (map_.size() < 8 + 4 * n_) { fprintf(stderr, "file too small\n"); return false; }
            keys_ = reinterpret_cast<const uint32_t*>(map_.data() + 8);
        } else {
            if (!f_.open(path, BinFile::Random)) { fprintf(stderr, "cannot open %s\n", path); return false; }
            if (f_.pread(&n_, 8, 0) != 8) { fprintf(stderr, "bad header\n"); return false; }
            if (f_.size() < 8 + 4 * n_) { fprintf(stderr, "file too small\n"); return false; }
            cache_.reset(new CacheSlot[CACHE_SLOTS]);
        }
        if (n_ == 0) return true;

        // ---- 희소 인덱스: 0, n/S, 2n/S, ... , n-1 번째 키 ----
        uint32_t s = static_cast<uint32_t>(std::min<uint64_t>(static_cast<uint64_t>(SAMPLE_COUNT), n_));
        sIdx_.resize(s + 1);
        sVal_.resize(s + 1);
        for (uint32_t j = 0; j < s; ++j) sIdx_[j] = n_ * j / s;
        sIdx_[s] = n_ - 1;
        for (uint32_t j = 0; j <= s; ++j) {
            if (useMmap_) sVal_[j] = keys_[sIdx_[j]];
            else if (f_.pread(&sVal_[j], 4, 8 + 4 * sIdx_[j]) != 4) { fprintf(stderr, "read error\n"); return false; }
        }
        return true;
    }

    // key의 위치(처음 등장하는 위치) 반환, 없으면 -1
    int64_t find(uint32_t key) {
        if (n_ == 0 || key < sVal_.front() || key > sVal_.back()) return -1;

        // 1) 희소 인덱스에서 key 이상인 첫 샘플 찾기 (메모리 안, 약 8번 비교)
        size_t j = std::lower_bound(sVal_.begin(), sVal_.end(), key) - sVal_.begin();
        if (j == 0) return 0;                       // key == 첫 키

        // 불변식: A[lo-1] = loVal < key <= hiVal = A[hi], 답은 [lo, hi] 안에 있음
        uint64_t lo = sIdx_[j - 1] + 1, hi = sIdx_[j];
        uint32_t loVal = sVal_[j - 1],   hiVal = sVal_[j];

        for (int iter = 0; lo < hi; ++iter) {
            // 2) 위치 추정: 처음 몇 번은 보간, 그 뒤엔 이분(최악의 경우 대비)
            uint64_t pos;
            if (iter < 4) {
                double frac = static_cast<double>(key - loVal) / static_cast<double>(hiVal - loVal);
                pos = (lo - 1) + static_cast<uint64_t>(frac * static_cast<double>(hi - lo + 1));
                if (pos < lo) pos = lo;
                if (pos > hi - 1) pos = hi - 1;
            } else {
                pos = lo + (hi - lo) / 2;
            }

            // 3) pos가 들어 있는 4KB 블록 가져오기
            Block blk = getBlock((8 + 4 * pos) / BLOCK_BYTES);
            uint64_t a = std::max(blk.first, lo);
            uint64_t b = std::min(blk.first + blk.count, hi);
            const uint32_t* keys = blk.keys;               // keys[0] = A[blk.first]
            uint32_t va = keys[a - blk.first], vb = keys[b - 1 - blk.first];

            if (va >= key) { hi = a; hiVal = va; continue; }       // 답은 블록 왼쪽
            if (vb <  key) { lo = b; loVal = vb; continue; }       // 답은 블록 오른쪽
            // 4) 답이 블록 안에 있음: 메모리에서 이진 탐색
            const uint32_t* p = std::lower_bound(keys + (a - blk.first), keys + (b - blk.first), key);
            return *p == key ? static_cast<int64_t>(blk.first + (p - keys)) : -1;
        }
        return hiVal == key ? static_cast<int64_t>(hi) : -1;
    }

    void printInfo() const {
        printf("Keys            : %llu  (min %u, max %u)\n",
               (unsigned long long)n_, n_ ? sVal_.front() : 0, n_ ? sVal_.back() : 0);
        printf("Sparse index    : %zu samples\n", sVal_.size());
        printf("File access     : %s\n", useMmap_ ? "memory-mapped" : "ReadFile + block cache");
    }
    void printStats() const {
        printf("Block accesses  : %llu", (unsigned long long)blockAccess_);
        if (!useMmap_) printf("  (disk reads %llu, cache hits %llu)",
                              (unsigned long long)(blockAccess_ - cacheHits_), (unsigned long long)cacheHits_);
        printf("\n");
    }

private:
    struct Block { uint64_t first; uint32_t count; const uint32_t* keys; };
    struct CacheSlot {
        int64_t  blockId = -1;
        uint64_t first = 0;
        uint32_t count = 0;
        uint32_t keys[KEYS_PER_BLOCK];
    };

    // 블록 경계는 4바이트 키 경계와 맞음 (8과 4096이 모두 4의 배수)
    Block getBlock(uint64_t blockId) {
        ++blockAccess_;
        uint64_t first = blockId == 0 ? 0 : (blockId * BLOCK_BYTES - 8) / 4;
        uint64_t end   = std::min<uint64_t>(n_, ((blockId + 1) * BLOCK_BYTES - 8) / 4);
        uint32_t count = static_cast<uint32_t>(end - first);
        if (useMmap_) return Block{ first, count, keys_ + first };

        CacheSlot& c = cache_[blockId % CACHE_SLOTS];
        if (c.blockId != static_cast<int64_t>(blockId)) {
            c.first = first;
            c.count = count;
            f_.pread(c.keys, count * 4, 8 + 4 * first);
            c.blockId = static_cast<int64_t>(blockId);
        } else {
            ++cacheHits_;
        }
        return Block{ c.first, c.count, c.keys };
    }

    bool useMmap_ = false;
    BinFile f_;
    MappedFile map_;
    const uint32_t* keys_ = nullptr;
    uint64_t n_ = 0;
    std::vector<uint64_t> sIdx_;
    std::vector<uint32_t> sVal_;
    std::unique_ptr<CacheSlot[]> cache_;
    uint64_t blockAccess_ = 0, cacheHits_ = 0;
};

int main(int argc, char** argv) {
    if (argc < 2) {
        fprintf(stderr, "usage: %s <dataset> [-q] [--mmap] [--limit512]\n", argv[0]);
        return 1;
    }
    if (hasFlag(argc, argv, "--limit512") && !applyMemoryLimit(512ull << 20))
        fprintf(stderr, "warning: failed to apply memory limit\n");

    OffsetIndex index;
    Stopwatch sw;
    if (!index.build(argv[1], hasFlag(argc, argv, "--mmap"))) return 1;
    double buildSec = sw.sec();

    printf("[Offset access + sparse index + interpolation]\n");
    index.printInfo();
    runQueries(index, buildSec, hasFlag(argc, argv, "-q"));
    index.printStats();
    printPeakMemory();
    return 0;
}
